# App
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# JWT Auth
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480

# PostgreSQL (runs on Pi 5)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tds_user
POSTGRES_PASSWORD=tds_secret
POSTGRES_DB=threat_detection

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_BUCKET_DETECTIONS=detection-images
MINIO_USE_SSL=false

# MQTT
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_DETECTIONS=sensors/+/detections
MQTT_TOPIC_HEALTH=sensors/+/health

# Prometheus
PROMETHEUS_ENABLED=true
